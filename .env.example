# =============================================================================
# DreamWeaver — environment variable reference
#
# This file is a SCHEMA of every env var the project consumes, organized by
# which workspace owns it. Copy the relevant sections into each workspace's
# local .env file (which is gitignored), or set them in the appropriate
# secret store (Cloud Secret Manager, GitHub Actions secrets).
#
# DO NOT put real values in this file. .env.example is committed; .env.local
# is gitignored. Real keys go in .env.local (local dev) OR in the relevant
# secret store (prod / CI).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. WEB CLIENT   →  apps/web/.env.local
#
# Get these from Firebase Console -> Project Settings -> "Your apps" ->
# Web app -> SDK setup and configuration -> Config.
#
# These ship in the JavaScript bundle that runs in the user's browser. They
# are technically PUBLIC — the Firebase web config is not a secret. We use
# .env.local for them anyway so dev/prod values don't get hardcoded.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe publishable key (also public — shipped to the client).
VITE_STRIPE_PUBLISHABLE_KEY=

# When developing against the local emulator suite:
#   VITE_USE_FIREBASE_EMULATORS=true
VITE_USE_FIREBASE_EMULATORS=


# -----------------------------------------------------------------------------
# 2. MOBILE CLIENT   →  apps/mobile/.env.local
#
# Same Firebase config as the web app, but Expo requires the EXPO_PUBLIC_
# prefix for vars exposed to client code.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# 3. FIREBASE FUNCTIONS   →  Google Cloud Secret Manager (NOT this file)
#
# These are the genuine secrets — server-side API keys. They MUST NOT live
# in any committed file, any .env.local, or any GitHub Actions secret.
#
# Set each one via the Firebase CLI:
#
#     firebase functions:secrets:set ANTHROPIC_API_KEY
#     firebase functions:secrets:set GEMINI_API_KEY
#     firebase functions:secrets:set STRIPE_SECRET_KEY
#     firebase functions:secrets:set STRIPE_WEBHOOK_SIGNING_SECRET
#
# Functions reference them in code via defineSecret() and they're injected
# at runtime by the Functions runtime. Rotation: re-run the same command.
#
# For LOCAL EMULATOR dev, the Functions runtime reads them from
# apps/functions/.secret.local (gitignored). Format: KEY=value, one per line.
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY              — console.anthropic.com -> API Keys
# GEMINI_API_KEY                 — aistudio.google.com -> Get API key
# STRIPE_SECRET_KEY              — dashboard.stripe.com -> Developers -> API keys
#                                  (use a Restricted Key with the minimum
#                                   permissions Functions actually needs)
# STRIPE_WEBHOOK_SIGNING_SECRET  — dashboard.stripe.com -> Webhooks ->
#                                  <your endpoint> -> Signing secret


# -----------------------------------------------------------------------------
# 4. GITHUB ACTIONS   →  Repo Settings -> Secrets and variables -> Actions
#
# Only needed once CI starts deploying to Firebase (Phase 10) or running
# integration tests that need to talk to a real Firebase project.
#
# Until then, CI runs only typecheck + lint + unit tests, which need no
# secrets at all.
#
# When you do add them:
#
#   FIREBASE_SERVICE_ACCOUNT_JSON
#       Generated from Firebase Console -> Project Settings -> Service
#       accounts -> "Generate new private key". Paste the entire JSON.
#       Used by FirebaseExtended/action-hosting-deploy (or w9jds/firebase-action)
#       to deploy hosting + functions + rules from CI.
#
# Anthropic / Gemini / Stripe keys NEVER go in GitHub Actions secrets —
# they belong in Cloud Secret Manager (section 3).
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_JSON=
